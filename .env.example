# Environment: development | test | production
APP_ENV=development

# Base URL of this Portal
PUBLIC_BASE_URL=http://localhost:8080

# Odoo Cloud Configuration (URL must be HTTPS in production)
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany

# SQLite Database Location
DATABASE_URL=sqlite:///./data/gateway.db
# Local SQLite runs one embedded worker. The PostgreSQL Compose overlay disables it.
WORKSPACE_EMBEDDED_WORKER=true
# For compose.postgres.yaml, set both values using the same password (URL-encode it in the URL).
# WORKSPACE_POSTGRES_PASSWORD=
# WORKSPACE_POSTGRES_URL=postgresql+psycopg://gateway:password@postgres/gateway

# Encryption Key (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Google Workspace OAuth Credentials
# Để trống GOOGLE_WORKSPACE_DOMAINS để cho phép mọi tài khoản Google, bao gồm Gmail cá nhân.
# Nếu cần giới hạn miền doanh nghiệp, điền danh sách cách nhau bởi dấu phẩy (ví dụ: mycompany.com,corp.com).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_WORKSPACE_DOMAINS=
# Enable the Google Workspace APIs and MCP services before opting in.
GOOGLE_WORKSPACE_MCP_ENABLED=false

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=MyCompanyOdooBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# Optional web verification. Use the technical Char field on hr.employee.
ODOO_EMPLOYEE_TELEGRAM_ID_FIELD=
# BotFather > Login Widget. Register the Telegram web base URL + /oauth/telegram/callback.
# Optional HTTPS URL for Telegram only. Defaults to PUBLIC_BASE_URL.
TELEGRAM_WEB_BASE_URL=
TELEGRAM_WEB_CLIENT_ID=
TELEGRAM_WEB_CLIENT_SECRET=

# AI Agent Integration (Gateway Mode: Gateway chạy port 8080, Agent chạy port 8000)
# Hai secret GATEWAY_TO_AGENT_SECRET và AGENT_TO_GATEWAY_SECRET phải khác nhau,
# tối thiểu 32 ký tự và khớp chính xác giữa Gateway và Agent.
ENABLE_AI_AGENT_FORWARDING=true
AI_AGENT_BASE_URL=http://localhost:8000
GATEWAY_TO_AGENT_SECRET=your_gateway_to_agent_secret_min32chars_here
AGENT_TO_GATEWAY_SECRET=your_agent_to_gateway_secret_min32chars_here

# Business reports and draft quotations (enable after configuration)
ENABLE_REPORTING=false
ENABLE_QUOTATIONS=false

# New permission-scoped business actions: enable only after acceptance per group.
ENABLE_BUSINESS_ACTIONS=false
ENABLE_QUOTATION_APPROVAL_FLOW=false
ENABLE_BUSINESS_CONTACTS=false
ENABLE_BUSINESS_PRODUCTS=false
ENABLE_BUSINESS_CRM=false
ENABLE_BUSINESS_SALES=false
ENABLE_BUSINESS_PURCHASES=false
ENABLE_BUSINESS_STOCK=false
ENABLE_BUSINESS_ACTIVITIES=false
ENABLE_BUSINESS_NOTES=false
ENABLE_BUSINESS_DELETE=false
ENABLE_BUSINESS_EMAIL=false
